// 6. [수정] 이메일 HTML 구성
// ==========================================
/**
 * 이메일 본문을 구성합니다.
 * - 최상단: Executive Summary
 * - 키워드별 섹션: 중요도 내림차순(★★★ → ★★ → ★) 정렬
 *
 * @param {Array}  allNews          - 뉴스 객체 배열 (stars, score 포함)
 * @param {number} searchDays
 * @param {string} executiveSummary - HTML 형식 요약문
 * @returns {string} HTML 이메일 본문
 */
function composeEmailContent(allNews, searchDays, executiveSummary) {
  const today    = new Date().toLocaleDateString("ko-KR");
  const fromDate = new Date();
  fromDate.setDate(fromDate.getDate() - searchDays);
  const fromStr  = fromDate.toLocaleDateString("ko-KR");

  // 키워드별 그룹핑
  const grouped = {};
  for (const news of allNews) {
    if (!grouped[news.keyword]) grouped[news.keyword] = [];
    grouped[news.keyword].push(news);
  }

  // 각 키워드 내 중요도 내림차순 정렬
  for (const kw of Object.keys(grouped)) {
    grouped[kw].sort((a, b) => (b.score || 1) - (a.score || 1));
  }

  // ── 별점 색상 헬퍼 ──────────────────────────────
  const starsHtml = (stars) => {
    const color = stars === "★★★" ? "#E8221A"
                : stars === "★★"  ? "#FF8C00"
                :                   "#888888";
    return `<span style="color:${color};font-weight:bold;font-size:15px;letter-spacing:1px;">${stars}</span>`;
  };

  // ── HTML 조립 ────────────────────────────────────
  let html = `
