// ==========================================
// 0. 상수 정의
// ==========================================
const NEWS_SHEET_NAME = "설정";
const GEMINI_API_SHEET_NAME = "Gemini API 설정";

// Gemini API 설정
const GEMINI_MODEL = "gemini-1.5-flash-latest";
const GEMINI_API_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/models/";

// 중요도 레이블
const IMPORTANCE = {
  HIGH:   { stars: "★★★", score: 3 },
  MEDIUM: { stars: "★★",  score: 2 },
  LOW:    { stars: "★",   score: 1 },
};

// ==========================================
// 1. 메뉴 생성
// ==========================================
function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu("🟢 뉴스 요약 실행")
    .addItem("📧 이메일 발송하기", "sendWeeklyNewsEmail")
    .addToUi();
}

// ==========================================
// 2. 메인 실행 함수
// ==========================================
function sendWeeklyNewsEmail() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  // ── 설정 값 불러오기 ──────────────────────────
  const keywordCombos      = getKeywordCombos(ss, NEWS_SHEET_NAME);
  const recipientsRaw      = getSettingValue(ss, NEWS_SHEET_NAME, "메일 수신자");
  const recipients         = recipientsRaw
    ? recipientsRaw.split(",").map(r => r.trim()).filter(Boolean)
    : [];
  const searchDaysVal      = getSettingValue(ss, NEWS_SHEET_NAME, "검색 기간");
  const searchDays         = searchDaysVal ? parseInt(searchDaysVal) : 1;

  // ── API Key 불러오기 (Gemini + Naver) ──────────
  const geminiApiKey       = getSettingValue(ss, GEMINI_API_SHEET_NAME, "Gemini API Key");
  const naverClientId      = getSettingValue(ss, GEMINI_API_SHEET_NAME, "Naver Client ID");
  const naverClientSecret  = getSettingValue(ss, GEMINI_API_SHEET_NAME, "Naver Client Secret");

  // ── 언론사 필터 ────────────────────────────────
  const allowedPublishersRaw = getSettingValue(ss, NEWS_SHEET_NAME, "필터링할 언론사 (쉼표로 구분)");
  const allowedPublishers    = allowedPublishersRaw
    ? allowedPublishersRaw.split(",").map(p => p.trim()).filter(Boolean)
    : [];

  // ── 필수 값 검증 ───────────────────────────────
  if (!geminiApiKey)          { alert_("Gemini API Key가 누락되었습니다."); return; }
  if (!naverClientId || !naverClientSecret) { alert_("네이버 Client ID/Secret이 누락되었습니다."); return; }
  if (keywordCombos.length === 0)           { alert_("검색 키워드가 설정되지 않았습니다."); return; }

  // ==========================================
  // Step 1. 키워드별 뉴스 수집
  // ==========================================
  const MAX_PER_KEYWORD = 6;
  let allNews = []; // { keyword, headline, link, summary, thumbnail, publisher, stars, score }

  for (const combo of keywordCombos) {
    const mainKeyword = combo.mainKeyword;
    Logger.log(`[수집] "${mainKeyword}" 검색 중...`);

    let articles = searchNaverNewsAPI(mainKeyword, searchDays, 100, naverClientId, naverClientSecret);

    // 언론사 필터
    if (allowedPublishers.length > 0) {
      articles = articles.filter(a => allowedPublishers.includes(a.publisher));
    }

    // ── Step 2. 의미 기반 중복 제거 (LLM 활용) ──
    articles = semanticDeduplication(articles, geminiApiKey);

    // 상위 N개만
    articles = articles.slice(0, MAX_PER_KEYWORD);

    if (articles.length === 0) continue;

    // ── Step 3. 중요도 판별 (LLM 배치 호출) ──────
    const scoredArticles = batchScoreImportance(articles, geminiApiKey);

    for (const a of scoredArticles) {
      allNews.push({
        keyword:   mainKeyword,
        headline:  a.headline,
        link:      a.link,
        summary:   a.description,
        thumbnail: a.thumbnail,
        publisher: a.publisher,
        stars:     a.stars,
        score:     a.score,
      });
    }

    Logger.log(`[완료] "${mainKeyword}" - ${scoredArticles.length}개 처리`);
    Utilities.sleep(500); // 키워드 간 간격
  }

  if (allNews.length === 0) {
    alert_("새로운 뉴스가 없습니다.");
    return;
  }

  // ── Step 4. Executive Summary 생성 ────────────
  const executiveSummary = generateExecutiveSummary(allNews, searchDays, geminiApiKey);

  // ── Step 5. 이메일 구성 및 발송 ───────────────
  const subject   = `[Sleep상품기획팀] 주간 뉴스 요약 (${new Date().toLocaleDateString("ko-KR")})`;
  const emailBody = composeEmailContent(allNews, searchDays, executiveSummary);

  if (recipients.length === 0) { alert_("메일 수신자가 설정되지 않았습니다."); return; }

  for (const recipient of recipients) {
    MailApp.sendEmail({ to: recipient, subject: subject, htmlBody: emailBody });
  }
  Browser.msgBox("성공", "뉴스 요약 메일 발송이 완료되었습니다.", Browser.Buttons.OK);
}

// ==========================================
// 3. [신규] 의미 기반 중복 제거 (LLM 배치)
// ==========================================
/**
 * LLM에게 기사 목록을 한 번에 보내 의미상 중복인 기사의 인덱스를 식별하게 합니다.
 * LLM 호출 실패 시 기존 단순 문자열 비교 방식으로 폴백합니다.
 *
 * @param {Array} articles - 원본 기사 배열
 * @param {string} geminiApiKey
 * @returns {Array} 중복 제거된 기사 배열
 */
function semanticDeduplication(articles, geminiApiKey) {
  if (articles.length <= 1) return articles;

  // 1차: 단순 URL/제목 완전 일치 제거 (빠른 사전 처리)
  const seen = new Set();
  let candidates = [];
  for (const a of articles) {
    const key = a.link + "||" + a.headline.slice(0, 20);
    if (!seen.has(key)) {
      seen.add(key);
      candidates.push(a);
    }
  }
  if (candidates.length <= 1) return candidates;

  // 2차: LLM 의미 분석
  const titlesJson = candidates.map((a, i) => `${i}: ${a.headline}`).join("\n");

  const prompt = `아래는 뉴스 기사 제목 목록입니다(인덱스: 제목 형식).
제목이 달라도 실질적으로 동일한 사건/보도자료를 다루는 중복 기사를 찾아주세요.
중복 그룹이 있을 경우, 각 그룹에서 인덱스가 가장 작은 기사만 남기고
나머지 인덱스를 "제거 대상"으로 반환하세요.

기사 목록:
${titlesJson}

반드시 아래 JSON 형식으로만 답변하세요. 다른 텍스트는 절대 포함하지 마세요.
{"remove": [제거할 인덱스 배열]}

중복이 없으면: {"remove": []}`;

  try {
    const result = callGeminiJSON(prompt, geminiApiKey);
    if (result && Array.isArray(result.remove)) {
      const removeSet = new Set(result.remove);
      Logger.log(`[중복제거] 제거 인덱스: ${JSON.stringify([...removeSet])}`);
      return candidates.filter((_, i) => !removeSet.has(i));
    }
  } catch (e) {
    Logger.log(`[중복제거] LLM 오류, 폴백 적용: ${e.message}`);
  }

  // 폴백: 기존 단순 비교
  return filterDuplicateNews(candidates);
}

// ==========================================
// 4. [신규] 중요도 배치 판별 (LLM 단일 호출)
// ==========================================
/**
 * 기사 배열 전체를 한 번의 LLM 호출로 중요도 판별합니다.
 * 실패 시 모든 기사에 ★(LOW) 부여.
 *
 * @param {Array} articles
 * @param {string} geminiApiKey
 * @returns {Array} stars, score 속성이 추가된 기사 배열
 */
function batchScoreImportance(articles, geminiApiKey) {
  const articlesJson = articles.map((a, i) => ({
    index: i,
    title: a.headline,
    snippet: (a.description || "").slice(0, 120),
  }));

  const prompt = `당신은 가구/침대/수면 업계 뉴스 중요도 분류 전문가입니다.
아래 기사 목록의 각 항목에 대해 중요도 등급을 판별해 주세요.

판별 기준:
- 3: 신제품 출시, 시장 규모, 매출과 관련된 뉴스
- 2: 가격 인상, 프로모션, 가구업계 동향과 관련된 뉴스
- 1: 위 기준에 해당하지 않는 기타 일반 뉴스

기사 목록(JSON):
${JSON.stringify(articlesJson)}

반드시 아래 JSON 형식으로만 답변하세요. 다른 텍스트는 절대 포함하지 마세요.
{"scores": [{"index": 0, "grade": 3}, {"index": 1, "grade": 1}, ...]}`;

  let scoreMap = {}; // index -> grade

  try {
    const result = callGeminiJSON(prompt, geminiApiKey);
    if (result && Array.isArray(result.scores)) {
      for (const s of result.scores) {
        scoreMap[s.index] = s.grade;
      }
    }
  } catch (e) {
    Logger.log(`[중요도] LLM 오류, 전체 ★ 적용: ${e.message}`);
  }

  return articles.map((a, i) => {
    const grade = scoreMap[i] || 1;
    const imp   = grade === 3 ? IMPORTANCE.HIGH : grade === 2 ? IMPORTANCE.MEDIUM : IMPORTANCE.LOW;
    return { ...a, stars: imp.stars, score: imp.score };
  });
}

// ==========================================
// 5. [신규] Executive Summary 생성
// ==========================================
/**
 * ★★★, ★★ 기사들을 바탕으로 전체 동향 요약(3~4줄) 생성.
 *
 * @param {Array} allNews
 * @param {number} searchDays
 * @param {string} geminiApiKey
 * @returns {string} HTML 형식의 요약 텍스트
 */
function generateExecutiveSummary(allNews, searchDays, geminiApiKey) {
  const keyArticles = allNews.filter(n => n.score >= 2);
  if (keyArticles.length === 0) {
    return "<p>이번 기간 주요 뉴스가 없습니다.</p>";
  }

  const keyTitles = keyArticles
    .map(n => `[${n.keyword}] ${n.stars} ${n.headline}`)
    .join("\n");

  const prompt = `당신은 가구/침대/수면 업계 전문 애널리스트입니다.
아래는 최근 ${searchDays}일간 수집된 중요 뉴스 목록입니다.

${keyTitles}

위 뉴스를 바탕으로 업계 전반의 동향을 3~4문장으로 간결하게 요약해 주세요.
- 한국어로 작성
- 전문적이고 객관적인 어조 유지
- 핵심 트렌드와 시사점 중심으로 서술
- 마크다운이나 특수기호 없이 순수 텍스트만 반환`;

  try {
    const raw = callGeminiText(prompt, geminiApiKey);
    if (raw) {
      return raw.split("\n").filter(Boolean).map(line => `<p>${line}</p>`).join("");
    }
  } catch (e) {
    Logger.log(`[요약] Executive Summary 생성 실패: ${e.message}`);
  }
  return "<p>핵심 뉴스 요약을 생성하지 못했습니다.</p>";
}

