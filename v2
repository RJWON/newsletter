  .header { background:linear-gradient(135deg,#1a3a5c,#2e6da4); color:#fff; padding:28px 32px; }
  .header h1 { margin:0 0 6px; font-size:20px; }
  .header p  { margin:0; font-size:13px; opacity:.8; }
  .section-exec { background:#fffbf0; border-left:5px solid #f0a500; padding:20px 28px; margin:0; }
