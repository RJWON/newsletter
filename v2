// ==========================================
// 7. Gemini API 호출 유틸리티
// ==========================================

/**
 * Gemini에 텍스트 프롬프트를 보내고 JSON 객체를 파싱하여 반환합니다.
 * 실패 시 예외를 throw합니다.
 */
function callGeminiJSON(prompt, apiKey) {
  const raw = callGeminiText(prompt, apiKey);
  // 코드블록 펜스 제거
  const cleaned = raw.replace(/```json|```/gi, "").trim();
  return JSON.parse(cleaned);
}

/**
 * Gemini에 텍스트 프롬프트를 보내고 응답 텍스트를 반환합니다.
 */
function callGeminiText(prompt, apiKey) {
  const url  = `${GEMINI_API_BASE_URL}${GEMINI_MODEL}:generateContent?key=${apiKey}`;
  const body = {
    contents: [{ parts: [{ text: prompt }] }],
    generationConfig: { temperature: 0.1, maxOutputTokens: 1024 },
  };
  const options = {
    method: "post",
    contentType: "application/json",
    payload: JSON.stringify(body),
    muteHttpExceptions: true,
  };

  const resp = UrlFetchApp.fetch(url, options);
  if (resp.getResponseCode() !== 200) {
    throw new Error(`Gemini API HTTP ${resp.getResponseCode()}: ${resp.getContentText().slice(0, 200)}`);
  }
  const json = JSON.parse(resp.getContentText());
  const text = json?.candidates?.[0]?.content?.parts?.[0]?.text;
  if (!text) throw new Error("Gemini 응답에 텍스트가 없습니다.");
  return text.trim();
}

// ==========================================
// 8. 기존 헬퍼 함수 (유지)
// ==========================================

function getSettingValue(ss, sheetName, itemName) {
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) return "";
  const data = sheet.getDataRange().getValues();
  for (const row of data) {
    if (row[0] === itemName) return row[1] != null ? row[1].toString().trim() : "";
  }
  return "";
}

function getKeywordCombos(ss, sheetName) {
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) return [];
  const data = sheet.getDataRange().getValues();
  if (data.length < 2) return [];
  const header  = data[0];
  const mainIdx = header.indexOf("메인 키워드");
  const subIdx  = header.indexOf("보조 키워드 (OR)");
  if (mainIdx === -1) return [];
  const combos = [];
  for (let i = 1; i < data.length; i++) {
    const mainKw = (data[i][mainIdx] || "").toString().trim();
    if (!mainKw) continue;
    const subKwStr = (subIdx !== -1 ? data[i][subIdx] : "").toString().trim();
    const subKws   = subKwStr.split(",").map(k => k.trim()).filter(Boolean);
    combos.push({ mainKeyword: mainKw, subKeywords: subKws });
  }
  return combos;
}

function searchNaverNewsAPI(keyword, days, limit, clientId, clientSecret) {
  const encodedKw = encodeURIComponent(keyword);
  const apiUrl    = `https://openapi.naver.com/v1/search/news.json?query=${encodedKw}&display=${limit}&sort=sim`;
  try {
    const resp = UrlFetchApp.fetch(apiUrl, {
      method: "get",
      headers: { "X-Naver-Client-Id": clientId, "X-Naver-Client-Secret": clientSecret },
      muteHttpExceptions: true,
    });
    if (resp.getResponseCode() !== 200) return [];
    const json = JSON.parse(resp.getContentText());
    if (!json.items?.length) return [];

    const cleanText = (t) => !t ? "" : t
      .replace(/<[^>]+>/g, "")
      .replace(/&quot;/g, '"').replace(/&amp;/g, "&")
      .replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&nbsp;/g, " ");

    const threshold = new Date();
    threshold.setHours(0, 0, 0, 0);
    threshold.setDate(threshold.getDate() - days);

    const articles = [];
    for (const item of json.items) {
      const pubDate = new Date(item.pubDate);
      pubDate.setHours(0, 0, 0, 0);
      if (pubDate < threshold) continue;
      articles.push({
        headline:    cleanText(item.title),
        link:        item.link,
        description: cleanText(item.description),
        pubDate:     pubDate,
        thumbnail:   item.thumbnail || null,
        publisher:   item.publisher || "알 수 없음",
      });
      if (articles.length >= limit) break;
    }
    return articles;
  } catch (e) {
    Logger.log(`[네이버API 오류] ${e.message}`);
    return [];
  }
}

/** 기존 단순 중복 제거 (LLM 폴백용으로 유지) */
function filterDuplicateNews(articles) {
  const seen = new Set();
  return articles.filter(a => {
    const key = a.headline.replace(/\s+/g, "").slice(0, 25);
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

function escapeHtml(text) {
  if (!text) return "";
  return text.toString()
    .replace(/&/g, "&amp;").replace(/</g, "&lt;")
    .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function alert_(msg) {
  Browser.msgBox("알림", msg, Browser.Buttons.OK);
}
